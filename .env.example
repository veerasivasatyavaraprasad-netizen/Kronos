# Copy to .env and fill in what you use. .env is git-ignored; never commit real secrets.

# ---- Web UI login (required when hosting publicly) ----
# Comma-separated user:password pairs. Leave empty to run without login (local use only).
KRONOS_USERS=admin:change-me
# Random string used to sign login sessions: python -c "import secrets; print(secrets.token_hex(32))"
KRONOS_SECRET_KEY=

# ---- Alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # Gmail: an App Password, not your normal password
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Binance (real-time bot: automation/live.yaml) ----
# Create the key at Binance -> API Management: enable "Spot & Margin Trading",
# keep "Withdrawals" DISABLED, and restrict access to your PC's IP address.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_BASE_URL=https://api.binance.com
# Optional practice exchange (mode: testnet) - free keys from https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# ---- Alpaca ----
# Paper keys start with "PK" and always use https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
# REAL MONEY switch. Required (together with mode: live in automation/live.yaml) for real orders.
# Leave empty while testing.
KRONOS_ALLOW_LIVE_TRADING=

# ---- Hosting ----
DOMAIN=                 # for the VPS/Caddy setup, e.g. kronos.example.com
