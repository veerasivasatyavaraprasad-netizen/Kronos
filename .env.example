# Copy to .env and fill in what you use. .env is git-ignored; never commit real secrets.

# ---- Web UI login (required when hosting publicly) ----
# Comma-separated user:password pairs. Leave empty to run without login (local use only).
KRONOS_USERS=admin:change-me
# Random string used to sign login sessions: python -c "import secrets; print(secrets.token_hex(32))"
KRONOS_SECRET_KEY=

# ---- Alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # Gmail: an App Password, not your normal password
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Binance (real-time bot: automation/live.yaml) ----
# Create the key at Binance -> API Management: enable "Spot & Margin Trading",
# keep "Withdrawals" DISABLED, and restrict access to your PC's IP address.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_BASE_URL=https://api.binance.com
# Optional practice exchange (mode: testnet) - free keys from https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# ---- Alpaca ----
# Paper keys start with "PK" and always use https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
# REAL MONEY switch. Required (together with mode: live in automation/live.yaml) for real orders.
# Leave empty while testing.
KRONOS_ALLOW_LIVE_TRADING=

# ---- Hosting ----
DOMAIN=                 # for the VPS/Caddy setup, e.g. kronos.example.com

# =====================================================================================================
# LunaTrade (python -m lunatrade run). Same Binance / Alpaca / alert variables as above, plus:
# =====================================================================================================
# REAL MONEY switch for LunaTrade (KRONOS_ALLOW_LIVE_TRADING=yes is accepted too). Leave empty while testing.
LUNATRADE_ALLOW_LIVE=
# Dashboard / API bearer token (empty -> a random one is written to outputs/lunatrade/api_token)
LUNATRADE_API_TOKEN=
# PIN for sensitive actions: emergency close, resume, mode change, kill-switch reset, voice commands
LUNATRADE_CONTROL_PIN=
# Overrides for lunatrade.yaml
LUNATRADE_MODE=                 # RESEARCH | PAPER | SHADOW | APPROVAL | LIVE
LUNATRADE_DATABASE_URL=         # e.g. postgresql+psycopg://lunatrade:pass@localhost:5432/lunatrade (empty = SQLite)
LUNATRADE_REDIS_URL=            # e.g. redis://localhost:6379/0 (optional event-bus mirror)
LUNATRADE_KAFKA_BOOTSTRAP=      # e.g. localhost:9092 (optional event-bus mirror)
POSTGRES_PASSWORD=              # used by docker-compose.lunatrade.yml

# ---- Voice agent ----
VOICE_PROVIDER=                 # speech-to-text: assemblyai | deepgram | openai
VOICE_TTS_PROVIDER=             # text-to-speech (optional): elevenlabs | openai
VOICE_API_KEY=                  # key of VOICE_PROVIDER
ELEVENLABS_API_KEY=             # only if TTS is ElevenLabs and differs from VOICE_API_KEY
ELEVENLABS_VOICE_ID=

# ---- LLM council (every provider with a key joins; none -> deterministic rules) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_HOST=                    # e.g. http://localhost:11434 for local models

# ---- Intelligence feeds (all optional; free public sources are used without keys) ----
WHALE_ALERT_API_KEY=            # whale transfers (https://whale-alert.io)
CRYPTOPANIC_API_KEY=            # extra news
X_BEARER_TOKEN=                 # X/Twitter recent search
